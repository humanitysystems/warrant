{
  "name": "warrant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local transparent MCP proxy with an admin console",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx src/server.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json --resolve-full-paths",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.8.1",
    "globals": "^15.14.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
