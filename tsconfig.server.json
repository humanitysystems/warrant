{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "preserve"
  },
  "include": [
    "src/server.ts",
    "src/config/**/*.ts",
    "src/proxy/**/*.ts",
    "src/transport/**/*.ts",
    "src/events/**/*.ts",
    "src/admin/**/*.ts"
  ]
}
